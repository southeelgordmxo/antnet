{
  "name": "antnet",
  "version": "0.11.0",
  "private": true,
  "description": "AntNet crypto research colony: web foraging and Claude source-grounded research",
  "author": "AntNet contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/southeelgordmxo/antnet.git"
  },
  "homepage": "https://antnet.live",
  "bugs": {
    "url": "https://github.com/southeelgordmxo/antnet/issues"
  },
  "keywords": [
    "antnet",
    "research",
    "claude",
    "web-crawler",
    "netlify"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch scripts/local-server.mjs",
    "build": "node scripts/build-app.mjs && node scripts/build-worker.mjs",
    "build:next": "next build --webpack",
    "build:netlify": "node scripts/build-app.mjs",
    "test:netlify": "node scripts/test-netlify.mjs",
    "preview": "node scripts/local-server.mjs",
    "start": "node scripts/local-server.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:pipeline": "node scripts/test-pipeline.mjs",
    "test:pdf": "node scripts/test-pdf.mjs",
    "browser:serve": "node services/browser-service.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@netlify/blobs": "^11.1.4",
    "@netlify/database": "^2.0.1",
    "@sparticuz/chromium": "^153.0.0",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.6.0",
    "next": "^16.3.8",
    "playwright": "^1.64.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "robots-parser": "^3.0.1",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.25.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
